{
  "mcpServers": {
    "agyteam_memory": {
      "command": "__PYTHON__",
      "args": ["-m", "agyteam.mcp_memory"],
      "env": {"PYTHONPATH": "__AGYTEAM_HOME__"}
    },
    "agyteam_bus": {
      "command": "__PYTHON__",
      "args": ["-m", "agyteam.mcp_bus"],
      "env": {"PYTHONPATH": "__AGYTEAM_HOME__"}
    }
  }
}
