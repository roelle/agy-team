{
  "_meta": {
    "description": "Raw contract and schema capture for google.antigravity ToolCall and ToolResult types",
    "python_version": "3.12.3 (main, Aug 31 2026, 10:18:26) [GCC 13.3.0]",
    "sdk_package": "google.antigravity",
    "probe_target": "PreToolCallDecideHook (call: ToolCall) and PostToolCallHook (res: ToolResult)"
  },
  "schemas": {
    "ToolCall": {
      "class": "google.antigravity.types.ToolCall",
      "base": "pydantic.BaseModel",
      "fields": {
        "name": {
          "type": "BuiltinTools | str",
          "required": true,
          "description": "BuiltinTools enum for builtin tools or str for MCP tools"
        },
        "args": {
          "type": "dict[str, Any]",
          "required": true,
          "description": "Parsed dictionary of arguments passed to the tool"
        },
        "id": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Harness call ID"
        },
        "step_id": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Harness step ID in format {trajectory_id}:{step_index}"
        },
        "canonical_path": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Canonical path if tool operates on a path"
        },
        "server_name": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "MCP server name (e.g. agyteam_bus) or None for builtin tools"
        }
      }
    },
    "ToolResult": {
      "class": "google.antigravity.types.ToolResult",
      "base": "pydantic.BaseModel",
      "fields": {
        "name": {
          "type": "BuiltinTools | str",
          "required": true,
          "description": "BuiltinTools enum for builtin tools or str for MCP tools"
        },
        "id": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Harness call ID correlating with ToolCall.id"
        },
        "step_id": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Harness step ID correlating with ToolCall.step_id"
        },
        "result": {
          "type": "Any",
          "required": false,
          "default": null,
          "description": "ToolOutput Pydantic model (with __str__()), raw str for MCP, or None on error"
        },
        "error": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "Error message if tool failed, or None on success"
        },
        "exception": {
          "type": "Exception | None",
          "required": false,
          "default": null,
          "description": "Exception instance if raised, or None"
        },
        "server_name": {
          "type": "str | None",
          "required": false,
          "default": null,
          "description": "MCP server name or None"
        }
      }
    }
  },
  "absent_fields_warning": {
    "ToolResult.args": "DOES NOT EXIST on ToolResult. getattr(res, \"args\", None) always returned None. Args must be captured during pre_trace from call.args.",
    "ToolResult.duration_s": "DOES NOT EXIST on ToolResult. Duration must be calculated via max(0.0, time.monotonic() - captured_t0) from pre_trace timestamp.",
    "ToolResult.duration": "DOES NOT EXIST on ToolResult."
  },
  "access_contract": {
    "tool_name": "res.name.value if isinstance(res.name, enum.Enum) else str(res.name)",
    "tool_args": "call.args directly in pre_trace (guaranteed dict[str, Any]); retrieve in trace via captured correlation map",
    "tool_result": "str(res.result) if res.result is not None else None",
    "tool_error": "str(res.error) if res.error is not None else (str(res.exception) if res.exception is not None else None)",
    "duration_s": "max(0.0, time.monotonic() - captured_t0) if captured_t0 is not None else None"
  },
